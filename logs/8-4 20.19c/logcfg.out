129: ;-------------------------TRIGGER-------------------------;
130: ; Triggers allow us to start/stop and resume logging to   ;
131: ; a file.  A default configuration has been setup for     ;
132: ; you to start with.  This will start logging when the    ;
133: ; engine starts (RPM > 0).                                ;
134: ;                                                         ;
135: ; A second configuration is also available.  It will log  ;
136: ; when you press the defogger switch and will stop the    ;
137: ; log when you turn the defogger off.  In order to use    ;
138: ; that configuration, remove the ";" at the beginning of  ;
139: ; the "Defogger Switch" lines and add a ";" to the others ;
140: ;---------------------------------------------------------;
141: ; Start log when RPM > 0
142: conditionrpn = RPM,0,>	
   : name[conditionrpn,48] value[RPM,0,>,0,0.000000]
143: action = start
   : name[action,49] value[start,0,0.000000]
144: ; Stop log when RPM = 0
145: conditionrpn = RPM,0,==
   : name[conditionrpn,48] value[RPM,0,==,0,0.000000]
146: action = stop
   : name[action,49] value[stop,0,0.000000]

